APP_ENV=development
CHECKOUT_RECOVERY_MAX_AUTO_INVENTORY_QUANTITY=1
CHECKOUT_RECOVERY_DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/checkout_recovery?sslmode=require

# Values are selected per azd environment; do not commit real resource identifiers or secrets.
CHECKOUT_RECOVERY_HOSTED_AGENT_NAME=checkout-recovery-maf
CHECKOUT_RECOVERY_FOUNDRY_MODEL_DEPLOYMENT=REPLACE_WITH_MODEL_DEPLOYMENT
CHECKOUT_RECOVERY_FOUNDRY_MODEL_NAME=REPLACE_WITH_MODEL_NAME
CHECKOUT_RECOVERY_FOUNDRY_MODEL_VERSION=REPLACE_WITH_MODEL_VERSION
CHECKOUT_RECOVERY_FOUNDRY_MODEL_SKU=GlobalStandard
CHECKOUT_RECOVERY_FOUNDRY_MODEL_CAPACITY=1

# The API Container App receives this from Bicep as a secret. Leave blank locally to disable export.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Hosted Responses uses the platform provider. Content collection must remain disabled.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
