# Editable checkout selects this lane's .env; process values override it.
# Installed/Hosted execution is environment-only. Never source this as shell code.
CHECKOUT_COPILOT_ENVIRONMENT=development
CHECKOUT_COPILOT_EXECUTION_MODE=scripted
CHECKOUT_COPILOT_API_HOST=127.0.0.1
CHECKOUT_COPILOT_API_PORT=8030
CHECKOUT_COPILOT_FRONTEND_ORIGIN=http://127.0.0.1:5180
CHECKOUT_COPILOT_API_TOKEN=
CHECKOUT_COPILOT_FOUNDRY_PROJECT_ENDPOINT=
CHECKOUT_COPILOT_MAX_AUTO_INVENTORY_QUANTITY=1
CHECKOUT_COPILOT_TRACE_FIXTURE_CONTENT=false
# Optional private local native-span receipt, outside packaged source:
CHECKOUT_COPILOT_TRACE_FILE=
CHECKOUT_COPILOT_DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/checkout_recovery?sslmode=require

# Values are selected per azd environment; do not commit real resource identifiers or secrets.
CHECKOUT_COPILOT_HOSTED_AGENT_NAME=checkout-recovery-copilot
CHECKOUT_COPILOT_FOUNDRY_MODEL_DEPLOYMENT=REPLACE_WITH_MODEL_DEPLOYMENT
CHECKOUT_COPILOT_FOUNDRY_MODEL_NAME=REPLACE_WITH_MODEL_NAME
CHECKOUT_COPILOT_FOUNDRY_MODEL_VERSION=REPLACE_WITH_MODEL_VERSION
CHECKOUT_COPILOT_FOUNDRY_MODEL_SKU=GlobalStandard
CHECKOUT_COPILOT_FOUNDRY_MODEL_CAPACITY=1

# The API Container App receives this from Bicep as a secret. Leave blank locally to disable export.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Hosted Responses uses the platform provider. Blanket native capture stays disabled;
# the explicit fixture switch above permits only validated synthetic diagnostics.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_TOOL_CONTENT=false
