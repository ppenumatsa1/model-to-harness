# Copy to this lane's private .env and fill the required values before real startup.
# Constructor overrides > process environment > selected lane .env > safe defaults.
# Never reads repository/neighbor dotenv files. _env_file=None disables dotenv.
# Installed wheels/hosted bundles use process environment unless explicitly overridden.
# Restart backend and Vite after changes. Never source private dotenv into a shell log.
APP_ENV=local
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
FRONTEND_HOST=localhost
FRONTEND_PORT=5173
# Optional; defaults to HTTP HOST:PORT (wildcard bind addresses use 127.0.0.1).
# Server-only; must be an HTTP(S) origin without credentials, path, query or fragment.
# BACKEND_PROXY_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173

# Required storage. Supply your own PostgreSQL connection URL privately; no fallback.
DATABASE_URL=
LANGGRAPH_SCHEMA=langgraph_app_cutover
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph_checkpoints_cutover
# Integration tests read TEST_DATABASE_URL only from the process environment.
# Use a dedicated loopback PostgreSQL test database; tests create/drop random schema pairs.
# TEST_DATABASE_URL=

# Required for real model-backed runs. Tests inject a fake model.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-model-deployment
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional; omitted means use the deployed model default.
# MODEL_TEMPERATURE=0.25
# Prefer az login / managed identity; no API key is required by this application.

# Local exporter is opt-in by supplying a connection string, and can be disabled explicitly.
TELEMETRY_ENABLED=true
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=model-to-harness-langgraph
# These must remain false. Process values cannot be hidden by constructor overrides.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
# API owns only providers it installs; hosted SDK providers are borrowed, never mutated/closed.
# Complete-retention sampling is mandatory. SDK OTEL_* process variables still apply;
# actual hosted sampler and redundant transport opt-outs are verified at startup.
# Vite selects ONLY HOST/PORT/FRONTEND_HOST/FRONTEND_PORT/BACKEND_PROXY_URL on the server.
# No lane dotenv values (including VITE_* keys) are exposed through import.meta.env.
