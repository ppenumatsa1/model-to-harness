APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql://model_to_harness:local-development-only@localhost:5432/model_to_harness
LANGGRAPH_SCHEMA=langgraph_app_cutover
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph_checkpoints_cutover
CORS_ORIGINS=http://localhost:5173
# TEST_DATABASE_URL should target a dedicated database when running integration tests.

# Required for real local model-backed runs. Tests inject a fake model.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-model-deployment
AZURE_OPENAI_API_VERSION=2024-10-21
# Prefer `az login`/managed identity. Do not put credentials in source control.
