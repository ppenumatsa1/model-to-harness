# Copy to maf/.env, never to backend/, frontend/, the repo root, or another lane.
# Editable checkout entrypoints resolve this exact file independent of launch cwd.
# Settings constructor values > process env > selected dotenv > safe defaults.
# Settings(_env_file=None) disables dotenv; _env_file=path explicitly selects a file.
# Installed wheels/hosted bundles use process env, not a guessed checkout parent.
# Restart API and Vite after changes (Settings is cached; Vite reads at startup).
# Never source this file into a shell or expose it through VITE_* / client defines.
# Only the canonical keys below are consumed; azd output aliases are not mapped.
# Dotenv does not populate os.environ. SDK-specific environment controls must be
# supplied in the process environment, including OTEL_SDK_DISABLED,
# OTEL_*_EXPORTER and OTEL_PYTHON_DISABLED_INSTRUMENTATIONS.

APP_ENV=development
HOST=127.0.0.1
PORT=8010
FRONTEND_ORIGIN=http://localhost:5174
LOG_LEVEL=INFO
MAX_TOOL_ATTEMPTS=3

# Required for real storage: replace with your MAF-only database connection.
# No credentials or database connection are assumed by backend code.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_SCHEMA=maf_double_charge

# Both required for real model-backed runs. Fake tests/evals disable dotenv.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=<deployment-name>

# Optional exporters; choose at most one. Blank disables each configured export path.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional telemetry labels; blank uses the runtime's existing host-specific fallback.
OTEL_SERVICE_NAME=
OTEL_SERVICE_VERSION=

# Vite-only server settings (never browser variables).
MAF_UI_PORT=5174
# Optional override. If omitted, target is http://HOST:PORT.
# Wildcard bind hosts 0.0.0.0 / :: map to loopback for the default proxy.
# Target must be an HTTP(S) origin without credentials, query, path, or fragment.
# MAF_API_PROXY_TARGET=http://127.0.0.1:8010
# Keep FRONTEND_ORIGIN aligned with the actual UI origin when changing UI port.
# Only this .env is read; .env.local and mode-specific dotenv files are not loaded.
# Vite --mode test disables dotenv entirely; browser fixtures set explicit local proxies.
