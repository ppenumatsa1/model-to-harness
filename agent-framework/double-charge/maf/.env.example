APP_ENV=development
HOST=127.0.0.1
PORT=8010
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/model_to_harness
DATABASE_SCHEMA=maf_double_charge
FRONTEND_ORIGIN=http://localhost:5174
LOG_LEVEL=INFO

# Required for real local model-backed runs. Tests inject FakeModelClient.
FOUNDRY_PROJECT_ENDPOINT=https://replace-me.services.ai.azure.com/api/projects/replace-me
FOUNDRY_MODEL=replace-me

# Optional OpenTelemetry/App Insights export. Never commit a real value.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=
